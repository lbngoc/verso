{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verso",
  "version": "0.1.2",
  "identifier": "app.versotranslate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popup",
        "url": "popup.html",
        "title": "Verso",
        "width": 380,
        "height": 180,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": true,
        "acceptFirstMouse": true
      },
      {
        "label": "quick",
        "url": "quick.html",
        "title": "Verso",
        "width": 560,
        "height": 320,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "Ngoc Luong",
    "copyright": "© 2026 Ngoc Luong, trading as Verso Translate",
    "category": "Productivity",
    "shortDescription": "Instant translation of selected or typed text",
    "longDescription": "Verso Translate — a lightweight menu bar translator for selected or typed text, with Google and Bing engines and automatic fallback.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/languages.json": "resources/languages.json",
      "../docs/public/TERMS.md": "licenses/TERMS.md",
      "../THIRD_PARTY.md": "licenses/THIRD_PARTY.md"
    },
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NDU1MjU0QTBDRUI5OTkKUldTWnVjNmdWRkpGT01xc29MVmhKZjFkbXNkc3B2b1JMWSsvVG4xcC9sM3FPZEdVd05LVjdOQU4K",
      "endpoints": [
        "https://github.com/lbngoc/verso-translate/releases/latest/download/latest.json"
      ],
      "require_signed_version": true
    }
  }
}
